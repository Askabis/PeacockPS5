diff --git a/tests/src/localOAuth.test.ts b/tests/src/localOAuth.test.ts
new file mode 100644
index 0000000..1dd3894
--- /dev/null
+++ b/tests/src/localOAuth.test.ts
@@ -0,0 +1,137 @@
+// Experimental PeacockPS5 local sessions. Copyright (C) 2026 Askabis
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import { beforeEach, describe, expect, it, vi } from "vitest"
+
+const settings = vi.hoisted(() => {
+    const profile = "12345678-1234-4234-8234-123456789abc"
+    const key = "ab".repeat(32)
+    process.env.PEACOCK_LOCAL_SESSION = "1"
+    process.env.PEACOCK_LOCAL_PROFILE_ID = profile
+    process.env.PEACOCK_LOCAL_PAIRING_KEY = key
+    return { profile, key }
+})
+vi.mock("../../components/officialServerAuth", () => ({
+    OfficialServerAuth: vi.fn(() => {
+        throw new Error("External authentication forbidden in local test")
+    }),
+    userAuths: new Map(),
+}))
+import { OfficialServerAuth } from "../../components/officialServerAuth"
+import {
+    error400,
+    error406,
+    error410,
+    handleOAuthToken,
+    type OAuthTokenBody,
+    type OAuthTokenResponse,
+} from "../../components/oauthToken"
+import * as database from "../../components/databaseHandler"
+import * as configs from "../../components/configSwizzleManager"
+import { extractToken } from "../../components/utils"
+import { localSession } from "../../components/localSession"
+import { mockRequestWithJwt } from "../helpers/testHelpers"
+import type { UserProfile } from "../../components/types/types"
+import type { Response } from "express"
+
+function request(address = "127.0.0.1") {
+    const req = mockRequestWithJwt<never, OAuthTokenBody>()
+    req.body = { grant_type: "peacock_local" } as OAuthTokenBody
+    req.headers["x-peacock-local-key"] = settings.key
+    Object.defineProperty(req, "socket", { value: { remoteAddress: address } })
+    return req
+}
+
+describe("Peacock local OAuth adapter", () => {
+    beforeEach(() => {
+        vi.restoreAllMocks()
+        vi.spyOn(database, "loadUserData").mockResolvedValue({
+            Id: settings.profile,
+            LinkedAccounts: { peacock_local: settings.profile },
+            Extensions: { entP: [] },
+        } as unknown as UserProfile)
+        vi.spyOn(database, "writeNewUserData").mockImplementation(
+            () => undefined,
+        )
+    })
+    it("creates a local session without official authentication", async () => {
+        const result = (await handleOAuthToken(request())) as OAuthTokenResponse
+        expect(localSession!.verifyAccess(result.access_token).sub).toBe(
+            settings.profile,
+        )
+        expect(OfficialServerAuth).not.toHaveBeenCalled()
+        expect(database.writeNewUserData).not.toHaveBeenCalled()
+    })
+    it("rejects the LAN and wrong pairing key before loading profiles", async () => {
+        expect(await handleOAuthToken(request("192.168.1.8"))).toBe(error406)
+        const req = request()
+        req.headers["x-peacock-local-key"] = "wrong"
+        expect(await handleOAuthToken(req)).toBe(error400)
+        expect(database.loadUserData).not.toHaveBeenCalled()
+    })
+    it("does not treat PSN as a local login", async () => {
+        const req = request()
+        req.body.grant_type = "external_psn" as OAuthTokenBody["grant_type"]
+        expect(await handleOAuthToken(req)).toBe(error406)
+        expect(OfficialServerAuth).not.toHaveBeenCalled()
+    })
+    it("never overwrites a profile from another platform", async () => {
+        vi.mocked(database.loadUserData).mockResolvedValue({
+            LinkedAccounts: { steam: "existing" },
+        } as UserProfile)
+        expect(await handleOAuthToken(request())).toBe(error410)
+        expect(database.writeNewUserData).not.toHaveBeenCalled()
+    })
+    it("creates new profiles without invented entitlements", async () => {
+        vi.mocked(database.loadUserData).mockRejectedValue(
+            Object.assign(new Error("Missing"), { code: "ENOENT" }),
+        )
+        vi.spyOn(configs, "getVersionedConfig").mockReturnValue({
+            LinkedAccounts: {},
+            Extensions: { entP: ["not-owned"] },
+        })
+        const result = (await handleOAuthToken(request())) as OAuthTokenResponse
+        expect(result.access_token).toBeTruthy()
+        const profile = vi.mocked(database.writeNewUserData).mock.calls[0][1]
+        expect(profile.Extensions.entP).toEqual([])
+        expect(profile.LinkedAccounts).toEqual({
+            peacock_local: settings.profile,
+        })
+    })
+    it("does not replace corrupt profiles", async () => {
+        vi.mocked(database.loadUserData).mockRejectedValue(
+            new SyntaxError("Corrupt profile"),
+        )
+        await expect(handleOAuthToken(request())).rejects.toThrow(
+            "Corrupt profile",
+        )
+        expect(database.writeNewUserData).not.toHaveBeenCalled()
+    })
+    it("refreshes through the local adapter only", async () => {
+        const token = (await handleOAuthToken(request())) as OAuthTokenResponse
+        const req = request()
+        req.body = {
+            grant_type: "refresh_token",
+            refresh_token: token.refresh_token,
+        } as OAuthTokenBody
+        req.headers.authorization = `Bearer ${token.access_token}`
+        expect(
+            ((await handleOAuthToken(req)) as OAuthTokenResponse).refresh_token,
+        ).not.toBe(token.refresh_token)
+        expect(await handleOAuthToken(req)).toBe(error400)
+        expect(OfficialServerAuth).not.toHaveBeenCalled()
+    })
+    it("checks local signatures in the normal request middleware", () => {
+        const req = request()
+        req.headers.authorization = `Bearer ${localSession!.issue().access_token}`
+        const next = vi.fn()
+        extractToken(req, undefined, next)
+        expect(req.jwt.unique_name).toBe(settings.profile)
+        expect(next).toHaveBeenCalledWith()
+        req.headers.authorization += "tampered"
+        const response = { status: vi.fn().mockReturnThis(), send: vi.fn() }
+        const rejectedNext = vi.fn()
+        extractToken(req, response as unknown as Response, rejectedNext)
+        expect(response.status).toHaveBeenCalledWith(401)
+        expect(rejectedNext).not.toHaveBeenCalled()
+    })
+})
