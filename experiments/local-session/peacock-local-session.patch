new file mode 100644
index 0000000..9d5dfa2
--- /dev/null
+++ b/tests/src/localSession.test.ts
@@ -0,0 +1,124 @@
+// Experimental PeacockPS5 local sessions. Copyright (C) 2026 Askabis
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import { afterEach, describe, expect, it, vi } from "vitest"
+import { sign } from "jsonwebtoken"
+import {
+    isLocalToken,
+    isLoopback,
+    LocalSession,
+    localSessionConfig,
+} from "../../components/localSession"
+
+const config = {
+    pairingKey: "ab".repeat(32),
+    profileId: "12345678-1234-4234-8234-123456789abc",
+}
+afterEach(() => vi.useRealTimers())
+
+describe("local sessions", () => {
+    it("is disabled unless explicitly configured", () => {
+        expect(localSessionConfig({})).toBeUndefined()
+        expect(
+            localSessionConfig({ PEACOCK_LOCAL_SESSION: "0" }),
+        ).toBeUndefined()
+        expect(() =>
+            localSessionConfig({ PEACOCK_LOCAL_SESSION: "1" }),
+        ).toThrow()
+    })
+    it("validates configuration without echoing secrets", () => {
+        expect(
+            localSessionConfig({
+                PEACOCK_LOCAL_SESSION: "1",
+                PEACOCK_LOCAL_PAIRING_KEY: config.pairingKey,
+                PEACOCK_LOCAL_PROFILE_ID: config.profileId,
+            }),
+        ).toEqual(config)
+        expect(() =>
+            localSessionConfig({
+                PEACOCK_LOCAL_SESSION: "1",
+                PEACOCK_LOCAL_PAIRING_KEY: "invalid-secret",
+            }),
+        ).toThrow("Invalid local-session configuration")
+    })
+    it("accepts only exact loopback socket addresses", () => {
+        for (const address of ["127.0.0.1", "::1", "::ffff:127.0.0.1"])
+            expect(isLoopback(address)).toBe(true)
+        for (const address of [
+            undefined,
+            "192.168.1.8",
+            "127.0.0.1.evil",
+            "8.8.8.8",
+        ])
+            expect(isLoopback(address)).toBe(false)
+    })
+    it("requires the pairing key", () => {
+        const session = new LocalSession(config)
+        expect(session.pair(config.pairingKey)).toBe(true)
+        for (const key of [undefined, "", [], "cd".repeat(32)])
+            expect(session.pair(key)).toBe(false)
+    })
+    it("issues a locally signed identity without platform credentials", () => {
+        const session = new LocalSession(config)
+        const token = session.issue()
+        const claims = session.verifyAccess(token.access_token)
+        expect(claims.sub).toBe(config.profileId)
+        expect(claims.platform).toBe("peacock_local")
+        expect(claims.aud).toBe("peacock-local-research")
+        expect(claims).not.toHaveProperty("authcode")
+        expect(JSON.stringify(token)).not.toContain(config.pairingKey)
+    })
+    it("rejects forged tokens even with a known pairing key", () => {
+        const session = new LocalSession(config)
+        const token = sign(
+            { sub: config.profileId, "auth:method": "peacock_local" },
+            config.pairingKey,
+        )
+        expect(session.isCandidate(token)).toBe(true)
+        expect(isLocalToken(token)).toBe(true)
+        expect(() => session.verifyAccess(token)).toThrow()
+    })
+    it("rejects a different instance's signature", () => {
+        const session = new LocalSession(config)
+        expect(() =>
+            session.verifyAccess(new LocalSession(config).issue().access_token),
+        ).toThrow()
+    })
+    it("rotates refresh credentials and rejects replay", () => {
+        const session = new LocalSession(config)
+        const first = session.issue()
+        const second = session.refresh(first.access_token, first.refresh_token)
+        expect(second.refresh_token).not.toBe(first.refresh_token)
+        expect(() =>
+            session.refresh(first.access_token, first.refresh_token),
+        ).toThrow()
+        expect(() =>
+            session.refresh(second.access_token, "ef".repeat(32)),
+        ).toThrow()
+    })
+    it("expires access but allows refresh within one hour", () => {
+        vi.useFakeTimers()
+        const session = new LocalSession(config)
+        const first = session.issue()
+        vi.advanceTimersByTime(301000)
+        expect(() => session.verifyAccess(first.access_token)).toThrow()
+        expect(
+            session.refresh(first.access_token, first.refresh_token)
+                .access_token,
+        ).toBeTruthy()
+    })
+    it("expires refresh and invalidates it after restart", () => {
+        vi.useFakeTimers()
+        const session = new LocalSession(config)
+        const first = session.issue()
+        expect(() =>
+            new LocalSession(config).refresh(
+                first.access_token,
+                first.refresh_token,
+            ),
+        ).toThrow()
+        vi.advanceTimersByTime(3600000)
+        expect(() =>
+            session.refresh(first.access_token, first.refresh_token),
+        ).toThrow()
+    })
+})
