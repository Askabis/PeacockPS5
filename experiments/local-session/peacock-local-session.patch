+// Experimental PeacockPS5 local sessions. Copyright (C) 2026 Askabis
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import { createHash, randomBytes, timingSafeEqual } from "crypto"
+import { decode, sign, verify, type JwtPayload } from "jsonwebtoken"
+
+export const LOCAL_GRANT = "peacock_local"
+const ISSUER = "peacock-local"
+const AUDIENCE = "peacock-local-research"
+const PROFILE_ID =
+    /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+
+export type LocalSessionConfig = { pairingKey: string; profileId: string }
+
+export function localSessionConfig(
+    env: NodeJS.ProcessEnv,
+): LocalSessionConfig | undefined {
+    if (env.PEACOCK_LOCAL_SESSION !== "1") return undefined
+    const pairingKey = env.PEACOCK_LOCAL_PAIRING_KEY || ""
+    const profileId = env.PEACOCK_LOCAL_PROFILE_ID || ""
+
+    if (!/^[0-9a-f]{64}$/.test(pairingKey) || !PROFILE_ID.test(profileId)) {
+        throw new Error(
+            "Invalid local-session configuration; use a dedicated UUID v4 and a 32-byte lowercase hex pairing key",
+        )
+    }
+
+    return { pairingKey, profileId }
+}
+
+function hash(value: string): Buffer {
+    return createHash("sha256").update(value).digest()
+}
+
+export function isLoopback(address: string | undefined): boolean {
+    return (
+        address === "127.0.0.1" ||
+        address === "::1" ||
+        address === "::ffff:127.0.0.1"
+    )
+}
+
+export function isLocalToken(
+    token: string,
+    profileId = process.env.PEACOCK_LOCAL_PROFILE_ID,
+): boolean {
+    const claims = decode(token)
+    return (
+        !!claims &&
+        typeof claims === "object" &&
+        (claims["auth:method"] === LOCAL_GRANT ||
+            claims.platform === "peacock_local" ||
+            claims.iss === ISSUER ||
+            (!!profileId &&
+                (claims.sub === profileId || claims.unique_name === profileId)))
+    )
+}
+
+export class LocalSession {
+    private readonly signingKey = randomBytes(32)
+    private refreshHash: Buffer | undefined
+    private refreshExpires = 0
+
+    constructor(readonly config: LocalSessionConfig) {}
+
+    isCandidate(token: string): boolean {
+        return isLocalToken(token, this.config.profileId)
+    }
+
+    verifyAccess(token: string, refreshing = false): JwtPayload {
+        const claims = verify(token, this.signingKey, {
+            algorithms: ["HS256"],
+            issuer: ISSUER,
+            audience: AUDIENCE,
+            ignoreExpiration: refreshing,
+        })
+        if (
+            typeof claims === "string" ||
+            claims.sub !== this.config.profileId ||
+            claims.unique_name !== this.config.profileId ||
+            claims["auth:method"] !== LOCAL_GRANT ||
+            claims.platform !== "peacock_local"
+        )
+            throw new Error("Invalid local session")
+        return claims
+    }
+
+    pair(key: unknown): boolean {
+        return (
+            typeof key === "string" &&
+            /^[0-9a-f]{64}$/.test(key) &&
+            timingSafeEqual(hash(key), hash(this.config.pairingKey))
+        )
+    }
+
+    issue() {
+        const refresh = randomBytes(32).toString("hex")
+        this.refreshHash = hash(refresh)
+        this.refreshExpires = Date.now() + 3600000
+        return {
+            access_token: sign(
+                {
+                    "auth:method": LOCAL_GRANT,
+                    roles: "user",
+                    sub: this.config.profileId,
+                    unique_name: this.config.profileId,
+                    userid: this.config.profileId,
+                    platform: "peacock_local",
+                    locale: "en",
+                    rgn: "xx",
+                    cntry: "xx",
+                    pis: "peacock-local-research",
+                },
+                this.signingKey,
+                {
+                    algorithm: "HS256",
+                    issuer: ISSUER,
+                    audience: AUDIENCE,
+                    expiresIn: 300,
+                },
+            ),
+            token_type: "bearer",
+            expires_in: 300,
+            refresh_token: refresh,
+        }
+    }
+
+    refresh(access: string, refresh: unknown) {
+        this.verifyAccess(access, true)
+        if (
+            typeof refresh !== "string" ||
+            !/^[0-9a-f]{64}$/.test(refresh) ||
+            !this.refreshHash ||
+            Date.now() >= this.refreshExpires ||
+            !timingSafeEqual(hash(refresh), this.refreshHash)
+        )
+            throw new Error("Invalid local refresh")
+        return this.issue()
+    }
+}
+
+const config = localSessionConfig(process.env)
+export const localSession = config ? new LocalSession(config) : undefined
